# Android release 签名配置模板
#
# 使用方法：
# 1. 复制本文件为 key.properties（不要提交到版本控制）
# 2. 生成 keystore：
#    keytool -genkey -v -keystore ~/dalanhai.jks -keyalg RSA -keysize 2048 -validity 10000 -alias dalanhai
# 3. 填入下方对应字段
#
# ⚠️ key.properties 和 *.jks 已在 .gitignore 中排除，不会提交到版本控制

storePassword=你的keystore密码
keyPassword=你的key密码
keyAlias=dalanhai
storeFile=/Users/你的用户名/dalanhai.jks
